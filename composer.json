{
  "name": "genuka/pay-sdk",
  "description": "Server-side PHP SDK for the Genuka Pay API.",
  "type": "library",
  "license": "proprietary",
  "autoload": {
    "psr-4": {
      "Genuka\\Pay\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Genuka\\Pay\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "laravel/pint": "^1.29",
    "phpunit/phpunit": "^11.5"
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite Unit",
    "format": "pint"
  },
  "config": {
    "sort-packages": true
  }
}
